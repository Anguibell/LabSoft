# Detectar archivos de texto y normalizarlos en Git
* text=auto

# Mantener LF en el código fuente
*.cs   text eol=lf
*.csx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf